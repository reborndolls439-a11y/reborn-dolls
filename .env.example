# ─── Database (Supabase) ──────────────────────────────────────────────────────
# Go to: supabase.com → your project → Settings → Database → Connection string
#
# DATABASE_URL  → Use the "Transaction" pooler URI (port 6543)
#   Format: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres
#
# DIRECT_URL    → Use the "Session" pooler URI or direct connection (port 5432)
#   Format: postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres
#   (Required by Prisma for migrations — does NOT go through the pooler)
#
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Authentication ────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET="your-very-strong-secret-key-here"

# ─── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
FROM_EMAIL="Reborn Dolls <hello@reborndolls.com>"
ADMIN_EMAIL="admin@reborndolls.com"

# ─── Cloudinary ────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Browserless (Product Scraper) ────────────────────────────────────────────
BROWSERLESS_TOKEN="your-browserless-token"
BROWSERLESS_URL="https://chrome.browserless.io"

# ─── App URLs ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_STORE_URL="http://localhost:3000"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"
